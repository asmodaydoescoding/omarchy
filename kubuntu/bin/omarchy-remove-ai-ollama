#!/bin/bash
set -Eeuo pipefail
mode=${1:---dry-run}
[[ $mode == "--dry-run" || $mode == "--apply" ]] || { echo "Usage: omarchy-remove-ai-ollama [--dry-run|--apply]" >&2; exit 1; }
if [[ $mode == "--dry-run" ]]; then
  printf 'dry-run: stop Ollama service and remove package/models\n'
  exit 0
fi
sudo systemctl disable --now ollama.service 2>/dev/null || true
sudo apt remove ollama 2>/dev/null || true
rm -rf "$HOME/.ollama"
sudo rm -rf /var/lib/ollama
