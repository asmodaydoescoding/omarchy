#!/bin/bash
set -Eeuo pipefail
mode=${1:---dry-run}
[[ $mode == "--dry-run" || $mode == "--apply" ]] || { echo "Usage: omarchy-remove-ai-t3-code [--dry-run|--apply]" >&2; exit 1; }
if [[ $mode == "--dry-run" ]]; then
  printf 'dry-run: remove T3 Code AppImage and ~/.config/t3code\n'
  printf 'dry-run: preserve ~/.claude.json, ~/.grok, ~/.local/share/opencode, and ~/.npm\n'
  exit 0
fi
rm -f "$HOME/.local/share/omarchy-kubuntu-ai/apps/t3code.AppImage"
rm -rf "$HOME/.config/t3code" "$HOME/.t3"
